#. Plugin Name of the plugin
#: wt-eu-withdrawal-button.php
msgid "WebToffee EU Order Withdrawal Button for WooCommerce"
msgstr "WebToffee EU-fortrydelsesknap til WooCommerce"

#. Plugin URI of the plugin
#: wt-eu-withdrawal-button.php
msgid "https://www.wordpress.org/plugins/wt-eu-withdrawal-button"
msgstr "https://www.wordpress.org/plugins/wt-eu-withdrawal-button"

#. Description of the plugin
#: wt-eu-withdrawal-button.php
msgid ""
"Manage withdrawal of contract / order cancellation requests for WooCommerce "
"orders. EU-compliant, HPOS-compatible."
msgstr ""
"Administrer fortrydelse af kontrakt-/ordreannulleringsanmodninger for "
"WooCommerce-ordrer. EU-kompatibel, HPOS-kompatibel."

