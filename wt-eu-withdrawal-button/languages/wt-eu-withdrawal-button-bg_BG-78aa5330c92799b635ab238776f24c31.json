40\u044a\u0447\u0438\u0442\u0435\u043b\u043d\u043e"],"Withdrawal period":["\u0421\u0440\u043e\u043a \u0437\u0430 \u043e\u0442\u043a\u0430\u0437"],"days":["\u0434\u043d\u0438"],"Start countdown from":["\u041d\u0430\u0447\u0430\u043b\u043e \u043d\u0430 \u043e\u0442\u0431\u0440\u043e\u044f\u0432\u0430\u043d\u0435\u0442\u043e \u043e\u0442"],"Reason required":["\u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430 \u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u0430"],"Exclusions":["\u0418\u0437\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f"],"Exclude product types, categories, or specific products from withdrawal eligibility.":["\u0418\u0437\u043a\u043b\u044e\u0447\u0435\u0442\u0435 \u0442\u0438\u043f\u043e\u0432\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438, \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 \u0438\u043b\u0438 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438 \u043e\u0442 \u043f\u0440\u0430\u0432\u043e\u0442\u043e \u043d\u0430 \u043e\u0442\u043a\u0430\u0437."],"Excluded product types":["\u0418\u0437\u043a\u043b\u044e\u0447\u0435\u043d\u0438 \u0442\u0438\u043f\u043e\u0432\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438"],"Product types that cannot be withdrawn.":["\u0422\u0438\u043f\u043e\u0432\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438, \u043a\u043e\u0438\u0442\u043e \u043d\u0435 \u043f\u043e\u0434\u043b\u0435\u0436\u0430\u0442 \u043d\u0430 \u043e\u0442\u043a\u0430\u0437."],"Excluded categories":["\u0418\u0437\u043a\u043b\u044e\u0447\u0435\u043d\u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438"],"Products in these categories cannot be withdrawn.":["\u041f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0442\u0435 \u0432 \u0442\u0435\u0437\u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 \u043d\u0435 \u043f\u043e\u0434\u043b\u0435\u0436\u0430\u0442 \u043d\u0430 \u043e\u0442\u043a\u0430\u0437."],"Excluded products":["\u0418\u0437\u043a\u043b\u044e\u0447\u0435\u043d\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438"],"Search and select specific products that cannot be withdrawn.":["\u0422\u044a\u0440\u0441\u0435\u0442\u0435 \u0438 \u0438\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438, \u043a\u043e\u0438\u0442\u043e \u043d\u0435 \u043f\u043e\u0434\u043b\u0435\u0436\u0430\u0442 \u043d\u0430 \u043e\u0442\u043a\u0430\u0437."],"Order status":["\u0421\u0442\u0430\u0442\u0443\u0441 \u043d\u0430 \u043f\u043e\u0440\u044a\u0447\u043a\u0430\u0442\u0430"],"Automatically update order statuses when withdrawal requests are submitted or approved.":["\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0430\u043a\u0442\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0441\u0442\u0430\u0442\u0443\u0441\u0438\u0442\u0435 \u043d\u0430 \u043f\u043e\u0440\u044a\u0447\u043a\u0430\u0442\u0430 \u043f\u0440\u0438 \u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0435 \u0438\u043b\u0438 \u043e\u0434\u043e\u0431\u0440\u044f\u0432\u0430\u043d\u0435 \u043d\u0430 \u0438\u0441\u043a\u0430\u043d\u0438\u044f \u0437\u0430 \u043e\u0442\u043a\u0430\u0437."],"Set status to":["\u0417\u0430\u0434\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0441\u0442\u0430\u0442\u0443\u0441 \u043d\u0430"],"Configure admin notification recipients and the customer contact email shown in rejected withdrawal emails.":["\u041a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0438\u0440\u0430\u0439\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b\u0438\u0442\u0435 \u043d\u0430 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u044f \u0438 \u0438\u043c\u0435\u0439\u043b\u0430 \u0437\u0430 \u043a\u043e\u043d\u0442\u0430\u043a\u0442 \u0441 \u043a\u043b\u0438\u0435\u043d\u0442\u0430, \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d \u0432 \u0438\u043c\u0435\u0439\u043b\u0438\u0442\u0435 \u0437\u0430 \u043e\u0442\u0445\u0432\u044a\u0440\u043b\u0435\u043d \u043e\u0442\u043a\u0430\u0437."],"Email addresses that receive the new withdrawal request notification.":["\u0418\u043c\u0435\u0439\u043b \u0430\u0434\u0440\u0435\u0441\u0438, \u043a\u043e\u0438\u0442\u043e \u043f\u043e\u043b\u0443\u0447\u0430\u0432\u0430\u0442 \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u0435 \u0437\u0430 \u043d\u043e\u0432\u043e \u0438\u0441\u043a\u0430\u043d\u0435 \u0437\u0430 \u043e\u0442\u043a\u0430\u0437."],"Customer contact email":["\u0418\u043c\u0435\u0439\u043b \u0437\u0430 \u043a\u043e\u043d\u0442\u0430\u043a\u0442 \u0441 \u043a\u043b\u0438\u0435\u043d\u0442\u0430"],"Email address shown to customers when a withdrawal request is rejected and they need to contact you.":["\u0418\u043c\u0435\u0439\u043b \u0430\u0434\u0440\u0435\u0441, \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d \u043d\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0438\u0442\u0435, \u043a\u043e\u0433\u0430\u0442\u043e \u0438\u0441\u043a\u0430\u043d\u0435 \u0437\u0430 \u043e\u0442\u043a\u0430\u0437 \u0431\u044a\u0434\u0435 \u043e\u0442\u0445\u0432\u044a\u0440\u043b\u0435\u043d\u043e \u0438 \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u0441\u0435 \u0441\u0432\u044a\u0440\u0436\u0430\u0442 \u0441 \u0432\u0430\u0441."],"Withdrawal button shortcode":["\u0428\u043e\u0440\u0442\u043a\u043e\u0434 \u0437\u0430 \u0431\u0443\u0442\u043e\u043d\u0430 \u0437\u0430 \u043e\u0442\u043a\u0430\u0437"]," \u2014 Optional. Custom button text. Uses the default shortcode label when omitted.":[" \u2014 \u041f\u043e \u0438\u0437\u0431\u043e\u0440. \u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d \u0442\u0435\u043a\u0441\u0442 \u043d\u0430 \u0431\u0443\u0442\u043e\u043d\u0430. \u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430 \u0435\u0442\u0438\u043a\u0435\u0442\u0430 \u043f\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0448\u043e\u0440\u0442\u043a\u043e\u0434\u0430, \u0430\u043a\u043e \u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043d\u0430\u0442."]," \u2014 Optional. Extra CSS classes added to the button.":[" \u2014 \u041f\u043e \u0438\u0437\u0431\u043e\u0440. \u0414\u043e\u043f\u044a\u043b\u043d\u0438\u0442\u0435\u043b\u043d\u0438 CSS \u043a\u043b\u0430\u0441\u043e\u0432\u0435, \u0434\u043e\u0431\u0430\u0432\u0435\u043d\u0438 \u043a\u044a\u043c \u0431\u0443\u0442\u043e\u043d\u0430."],"Data management":["\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0434\u0430\u043d\u043d\u0438\u0442\u0435"],"Control what happens to plugin data when the plugin is removed.":["\u041a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0430\u0439\u0442\u0435 \u043a\u0430\u043a\u0432\u043e \u0441\u0435 \u0441\u043b\u0443\u0447\u0432\u0430 \u0441 \u0434\u0430\u043d\u043d\u0438\u0442\u0435 \u043d\u0430 \u043f\u0440\u0438\u0441\u0442\u0430\u0432\u043a\u0430\u0442\u0430, \u043a\u043e\u0433\u0430\u0442\u043e \u0442\u044f \u0431\u044a\u0434\u0435 \u043f\u0440\u0435\u043c\u0430\u0445\u043d\u0430\u0442\u0430."],"Delete data on uninstall":["\u0418\u0437\u0442\u0440\u0438\u0432\u0430\u043d\u0435 \u043d\u0430 \u0434\u0430\u043d\u043d\u0438\u0442\u0435 \u043f\u0440\u0438 \u0434\u0435\u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043d\u0435"],"Remove all plugin data (settings, withdrawal requests, database tables) when the plugin is uninstalled. This action is irreversible.":["\u041f\u0440\u0435\u043c\u0430\u0445\u0432\u0430\u043d\u0435 \u043d\u0430 \u0432\u0441\u0438\u0447\u043a\u0438 \u0434\u0430\u043d\u043d\u0438 \u043d\u0430 \u043f\u0440\u0438\u0441\u0442\u0430\u0432\u043a\u0430\u0442\u0430 (\u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438, \u0438\u0441\u043a\u0430\u043d\u0438\u044f \u0437\u0430 \u043e\u0442\u043a\u0430\u0437, \u0442\u0430\u0431\u043b\u0438\u0446\u0438 \u0432 \u0431\u0430\u0437\u0430\u0442\u0430 \u0434\u0430\u043d\u043d\u0438) \u043f\u0440\u0438 \u0434\u0435\u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043f\u0440\u0438\u0441\u0442\u0430\u0432\u043a\u0430\u0442\u0430. \u0422\u043e\u0432\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0435 \u043d\u0435\u043e\u0431\u0440\u0430\u0442\u0438\u043c\u043e."],"Destructive":["\u0420\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u043d\u043e"],"Add at least one recipient to save":["\u0414\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u043f\u043e\u043d\u0435 \u0435\u0434\u0438\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b, \u0437\u0430 \u0434\u0430 \u0437\u0430\u043f\u0430\u0437\u0438\u0442\u0435"],"Unsaved changes":["\u041d\u0435\u0437\u0430\u043f\u0430\u0437\u0435\u043d\u0438 \u043f\u0440\u043e\u043c\u0435\u043d\u0438"],"All changes saved":["\u0412\u0441\u0438\u0447\u043a\u0438 \u043f\u0440\u043e\u043c\u0435\u043d\u0438 \u0441\u0430 \u0437\u0430\u043f\u0430\u0437\u0435\u043d\u0438"],"Discard":["\u041e\u0442\u0445\u0432\u044a\u0440\u043b\u044f\u043d\u0435"],"Settings saved successfully.":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u0442\u0435 \u0441\u0430 \u0437\u0430\u043f\u0430\u0437\u0435\u043d\u0438 \u0443\u0441\u043f\u0435\u0448\u043d\u043e."],"Failed to save settings.":["\u041d\u0435\u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0437\u0430\u043f\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u0442\u0435."],"Add at least one admin notification recipient before saving.":["\u0414\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u043f\u043e\u043d\u0435 \u0435\u0434\u0438\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b \u043d\u0430 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0441\u043a\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u044f, \u043f\u0440\u0435\u0434\u0438 \u0434\u0430 \u0437\u0430\u043f\u0430\u0437\u0438\u0442\u0435."],"Saving...":["\u0417\u0430\u043f\u0430\u0437\u0432\u0430\u043d\u0435..."],"Save settings":["\u0417\u0430\u043f\u0430\u0437\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u0442\u0435"]}}}