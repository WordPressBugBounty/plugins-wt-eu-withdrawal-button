#. Plugin Name of the plugin
#: wt-eu-withdrawal-button.php
msgid "WebToffee EU Order Withdrawal Button for WooCommerce"
msgstr "WebToffee EU бутон за отказ от поръчка за WooCommerce"

#. Plugin URI of the plugin
#: wt-eu-withdrawal-button.php
msgid "https://www.wordpress.org/plugins/wt-eu-withdrawal-button"
msgstr "https://www.wordpress.org/plugins/wt-eu-withdrawal-button"

#. Description of the plugin
#: wt-eu-withdrawal-button.php
msgid ""
"Manage withdrawal of contract / order cancellation requests for WooCommerce "
"orders. EU-compliant, HPOS-compatible."
msgstr ""
"Управление на искания за отказ от договор / анулиране на поръчки за поръчки "
"в WooCommerce. Съвместимо с ЕС, съвместимо с HPOS."

#. Author of the plugin
#: wt-eu-withdrawal-button.php
msgid "webtoffee"
msgstr "webtoffee"

#. Author URI of the plugin
#: wt-eu-withdrawal-button.php
msgid "https://www.webtoffee.com/"
msgstr "https://www.webtoffee.com/"

